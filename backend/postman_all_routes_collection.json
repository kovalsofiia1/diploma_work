    {
      "name": "Tickets, Booking and Scanning",
      "item": [
        {
          "name": "POST /tickets/book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('booking response is successful', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.ticket) {",
                  "  pm.environment.set('ticket_id', String(json.ticket.id));",
