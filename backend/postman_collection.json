{
  "info": {
    "name": "Event Backend - User Profile & Cities Tests",
    "description": "Postman collection to test the user authentication, profile updates, event creation with images, and city subscriptions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "2. Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set(\"token\", jsonData.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "testuser@example.com",
              "type": "text"
            },
            {
              "key": "password",
              "value": "password123",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. Get Current User (Me)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "4. Update User Profile (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Updated Test User\",\n  \"date_of_birth\": \"1995-08-24\",\n  \"description\": \"This is my new profile description!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "5. Upload Profile Image",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/auth/me/image",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me",
            "image"
          ]
        }
      }
    },
    {
      "name": "6. Create Event with Image",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "My Awesome Event",
              "type": "text"
            },
            {
              "key": "description",
              "value": "This is a test event with an image upload.",
              "type": "text"
            },
            {
              "key": "city",
              "value": "Kyiv",
              "type": "text"
            },
            {
              "key": "startDate",
              "value": "2026-05-01T18:00:00Z",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/events",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "events"
          ]
        }
      }
    },
    {
      "name": "7. Get All Available Cities",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/cities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "cities"
          ]
        }
      }
    },
    {
      "name": "8. Update My City Subscriptions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cities\": [\n    \"Kyiv\",\n    \"Lviv\",\n    \"Online\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/me/cities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me",
            "cities"
          ]
        }
      }
    },
    {
      "name": "9. Get My City Subscriptions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/me/cities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me",
            "cities"
          ]
        }
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}